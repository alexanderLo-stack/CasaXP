
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/txtAgregarTitulo"
            style="@style/TituloCasaXP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agregar_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/txtAgregarSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/agregar_subtitulo"
            android:textColor="@color/texto_principal"
            android:textSize="16sp" />

        <!-- Nombre de la tarea -->
        <EditText
            android:id="@+id/edtNombreTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:minHeight="48dp"
            android:hint="@string/agregar_nombre"
            android:inputType="textCapSentences" />

        <!-- Descripción -->
        <EditText
            android:id="@+id/edtDescripcionTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:minHeight="48dp"
            android:hint="@string/agregar_descripcion"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top" />

        <!-- Tiempo objetivo -->
        <EditText
            android:id="@+id/edtTiempoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:minHeight="48dp"
            android:hint="@string/agregar_tiempo"
            android:inputType="number" />

        <!-- Título de prioridad -->
        <TextView
            android:id="@+id/txtPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/agregar_prioridad"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Selección de prioridad -->
        <RadioGroup
            android:id="@+id/rgPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/rbPrioridadMedia">

            <RadioButton
                android:id="@+id/rbPrioridadBaja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_baja"
                android:textColor="@color/texto_principal"
                android:buttonTint="@color/secundario" />

            <RadioButton
                android:id="@+id/rbPrioridadMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_media"
                android:textColor="@color/primario"
                android:buttonTint="@color/primario" />

            <RadioButton
                android:id="@+id/rbPrioridadAlta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_alta"
                android:textColor="@color/texto_principal"
                android:buttonTint="@color/primario" />

        </RadioGroup>

        <!-- Recompensa XP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/fondo_tarjeta">

            <TextView
                android:id="@+id/txtRecompensa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agregar_recompensa"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtXP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/agregar_xp"
                android:textColor="@color/primario"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Guardar tarea -->
        <Button
            android:id="@+id/btnGuardarTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/primario"
            android:text="@string/agregar_guardar"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>
